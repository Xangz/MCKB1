@model IEnumerable<NguyenDinhSang_241230832.Models.TaiSan>

<div class="grid">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="asset-card">
                <a href="#"><img src="~/images/@(string.IsNullOrEmpty(item.Anh) ? "Img_1.jpg" : item.Anh)" alt="@item.TenTs" /></a>
                <h2>@item.TenTs</h2>
                <div class="asset-foot">
                    <span class="price">@((item.NguyenGia.HasValue ? item.NguyenGia.Value.ToString("G29") : "0")) tr</span>
                    <button class="btn-buy" type="button">Chi tiết</button>
                </div>
            </div>
        }
    }
    else
    {
        <p style="padding: 20px;">Không có tài sản nào phù hợp.</p>
    }
</div>